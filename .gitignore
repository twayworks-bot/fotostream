# ==============================================================================
# FOTOSTREAM - Git Ignore Rules (.gitignore)
# Prevents accidental commitment of personal credentials, sensitive secrets,
# storage/database media, binaries, tool caches, and temporary files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Byte-compiled / Optimized / DLL files (Python 바이트코드 및 컴파일 캐시)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python

# ------------------------------------------------------------------------------
# 2. Environments, Secrets, and Credentials (환경변수, 개인정보, 비밀키, 토큰)
# ------------------------------------------------------------------------------
.env
*.env
.env.*
.env*.local
*.local.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# 공개 가능한 안전한 환경변수 예제 템플릿 파일 보존
!.env.example
!app.env.example

# 보안 인증서, 비밀키, SSH 키, 토큰 및 자격증명 파일
*token*
*.token
token.txt
tokens.json
secret*
*.secret
secrets.json
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.pub
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
credentials.json
client_secret*.json
service_account*.json
.netrc
.npmrc
.pypirc
.aws/
.ssh/

# 프로젝트 코드 중 파일명에 token/secret이 포함된 파일 보존 예외
!app/services/token_service.py
!app/templates/tokens.html
!app/templates/secrets.html

# ------------------------------------------------------------------------------
# 3. Persistent Storage, Databases & Media (영구 스토리지, DB, 미디어 파일)
# ------------------------------------------------------------------------------
storage/
downloads/
app/data/
data/

# SQLite 데이터베이스 및 트랜잭션 저널/WAL 파일
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
local_settings.py
db.sqlite3
db.sqlite3-journal

# 사용자 업로드 및 인코딩 동영상/오디오 파일
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm
*.m4v
*.ts
*.m3u8
*.mp3
*.aac
*.wav
*.flac
*.m4a

# ------------------------------------------------------------------------------
# 4. Host Binaries & Executables (로컬 바이너리 및 실행 파일)
# ------------------------------------------------------------------------------
bin/
*.exe
*.dll
*.so
*.dylib
old/
OLD/

# ------------------------------------------------------------------------------
# 5. Unit test, Coverage reports & Linter Caches (테스트 산출물 및 캐시)
# ------------------------------------------------------------------------------
.pytest_cache/
.cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
nosetests.xml
htmlcov/
cover/
*.cover
*.py,cover
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/

# ------------------------------------------------------------------------------
# 6. Distribution & Packaging (빌드 및 패키징 아티팩트)
# ------------------------------------------------------------------------------
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 7. Temporary Files, Logs, and Shell Histories (임시 파일, 로그, 쉘 기록)
# ------------------------------------------------------------------------------
*.log
logs/
scratch/
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*~
*.swp
*.swo

# 쉘 및 커맨드 히스토리 (개인정보 및 민감 명령어 보호)
.bash_history
.zsh_history
.python_history
.node_repl_history
history.md
.history
.history/

# 프로젝트 개발 이력 문서는 예외 보존
!notes/history.md

# ------------------------------------------------------------------------------
# 8. IDE, Editor & OS Metadata (에디터 설정 및 운영체제 메타데이터)
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
.ipynb_checkpoints
profile_default/
ipython_config.py
.gemini/

# GitHub Sync Script & Private Configurations
syncgithub.env
syncgithub.py
