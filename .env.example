# ==============================================================================
# FOTOSTREAM - Example Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Application Security & Network
APP_PIN=1234
HOST=0.0.0.0
PORT=5000
DEFAULT_PREFIX=fotostream

# Concurrency & System Limits
MAX_CONCURRENT_JOBS=3
MAX_CONCURRENT_STREAMS=10
MAX_IMAGES_COUNT=49
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SEC=600

# Retention & Storage Paths
RETENTION_DAYS=365
CLEANUP_INTERVAL_HOURS=24
DOWNLOAD_DIR=./downloads
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
BGM_DIR=./storage/bgm
TRANSCODE_DIR=./storage/transcoded
HLS_DIR=./storage/hls
DB_PATH=./storage/fotostream.db
DB_URL=sqlite:///./storage/fotostream.db

# FFmpeg Executables Configuration
# Windows: ./bin/ffmpeg.exe, Linux/Docker: /usr/bin/ffmpeg or ffmpeg
FFMPEG_PATH=./bin/ffmpeg.exe
FFPROBE_PATH=./bin/ffprobe.exe
